<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/colorPrimaryDark"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_form_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_add_ingredient"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextWhite" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Name Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_ingredient_name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:paddingTop="8dp" />

            <EditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_ingredient_name"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:padding="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@android:drawable/editbox_background" />

            <!-- Quantity Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_quantity"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:paddingTop="4dp" />

            <EditText
                android:id="@+id/et_quantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_quantity"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:padding="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@android:drawable/editbox_background" />

            <!-- Unit Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_unit"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:paddingTop="4dp" />

            <EditText
                android:id="@+id/et_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_unit"
                android:inputType="text"
                android:singleLine="true"
                android:padding="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="@android:drawable/editbox_background" />

            <!-- Quick Units Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_quick_units"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/ll_quick_units_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Expiry Date Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_expiry_date"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:paddingTop="4dp" />

            <EditText
                android:id="@+id/et_expiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_expiry_date"
                android:focusable="false"
                android:clickable="true"
                android:padding="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@android:drawable/editbox_background" />

            <!-- Save & Cancel Buttons -->
            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_save_ingredient"
                android:textAllCaps="false"
                android:textColor="@color/colorTextWhite"
                android:backgroundTint="@color/colorPrimary"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/colorTextWhite"
                android:backgroundTint="@color/colorTextSecondary" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorSurface">

        <Button
            android:id="@+id/nav_btn_pantry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_pantry"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:backgroundTint="@color/colorSurface" />

        <Button
            android:id="@+id/nav_btn_recipes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_recipes"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:backgroundTint="@color/colorSurface" />

        <Button
            android:id="@+id/nav_btn_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_settings"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:backgroundTint="@color/colorSurface" />
    </LinearLayout>

</LinearLayout>
